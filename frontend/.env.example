# FloraSentry V2 frontend (TRD 36.9)
# Copy to `.env`. Every VITE_ value is COMPILED INTO THE PUBLIC BUNDLE -
# never put a secret behind a VITE_ prefix.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=local
VITE_DEFAULT_LANGUAGE=en

# Map tile provider. UNSET BY DEFAULT: no provider has been selected and no
# provider's terms have been verified (TRD decision D16). Until one is chosen the
# map renders its data layers over a blank base - it does not silently pull tiles
# from a third party. Most providers also require a specific attribution string.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Map default view. Centred on Maharashtra, the PRD's MVP geography.
VITE_MAP_DEFAULT_CENTER=19.75,75.71
VITE_MAP_DEFAULT_ZOOM=7

# Client-side downscale target before upload (Phase 2).
VITE_MAX_IMAGE_EDGE_PX=1600
