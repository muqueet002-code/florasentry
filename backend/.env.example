# FloraSentry V2 backend - example environment (TRD 36)
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
#
# The application validates this configuration at startup and REFUSES TO BOOT on a
# missing or unsafe required value (TRD 36.10).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | ci | demo | production. Unsafe defaults are permitted only in `local`.
APP_ENV=local
APP_NAME=FloraSentry V2
APP_VERSION=0.1.0
# Injected at build time in CI; shown by /health so a deploy is identifiable.
GIT_SHA=unknown
# Must be false outside APP_ENV=local (enforced).
DEBUG=false
LOG_LEVEL=INFO
# json for machine collection, console for human-readable local development.
LOG_FORMAT=console
API_BASE_PATH=/api/v1
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,mr

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
# Use host `db` when running under docker compose, `localhost` when running the
# backend directly against a compose-exposed database.
DATABASE_URL=postgresql+psycopg://florasentry:florasentry@localhost:5432/florasentry
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SEC=30
# Bounds every statement so a slow query fails fast instead of hanging.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. Generate with:  openssl rand -hex 32
# Booting outside `local` with this literal example value is refused.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Explicit origin list. "*" is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# GIS
# ---------------------------------------------------------------------------
# minx,miny,maxx,maxy. Default covers Maharashtra (the PRD's MVP geography).
# Coordinates outside this box are rejected. TRD decision D24: confirm before pilot.
GIS_OPERATING_BBOX=72.6,15.6,80.9,22.1
# Projected metric CRS used for distance/area work (UTM 43N). TRD 9.1.
GIS_METRIC_SRID=32643

# ---------------------------------------------------------------------------
# Later-phase feature flags
# ---------------------------------------------------------------------------
# Phase 1 ships NO AI model, NO weather provider and NO sensor ingest.
# These stay false/none until the phase that implements them.
# Phase 2:
AI_ENABLED=false
# Phase 3. No provider has been selected or verified (TRD decision D5).
WEATHER_PROVIDER=none
# Phase 7+. Device authentication is undecided (TRD decision D21).
SENSOR_INGEST_ENABLED=false
